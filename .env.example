# Copy this file to .env (project root) and fill in real values.
# .env is gitignored — never commit real credentials.

# ---- LLM backends (core/generation/generator.py) ----
# Which backend RagChain uses by default: "gemini" | "ollama" | "agentrouter"
LLM_BACKEND=gemini

GOOGLE_API_KEY=your-google-ai-studio-key
AGENTROUTER_API_KEY=your-agentrouter-key

# How long Ollama keeps the generation model loaded after a reply.
# Lower on modest hardware, raise on a machine that can afford it.
OLLAMA_KEEP_ALIVE=5m

# ---- Retrieval (core/retrieval/retriever.py, rerank.py) ----
# "dense" | "hybrid"
RETRIEVER_MODE=hybrid
# "true" to enable cross-encoder reranking after retrieval
RERANK=false

# ---- Confidence gate (core/generation/rag_chain.py) ----
# Refuse without calling the LLM when the top retrieval score is below this.
# Empty/unset = disabled. See docs/retrieval-confidence-threshold.md before
# turning this on — 0.5 is the calibrated, conservative value on the current
# (small) evaluation set.
MIN_RETRIEVAL_SCORE=

# ---- Database (backend/config/settings.py) ----
DB_NAME=rag_system
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_HOST=localhost
DB_PORT=5432

# ---- Networking (backend/config/settings.py) ----
# Only needed if the app is unreachable at plain localhost/127.0.0.1 — e.g.
# a VPN's virtual adapter puts you on another hostname/IP. Comma-separated.
# See docs/vpn-connectivity.md.
DJANGO_ALLOWED_HOSTS=
CORS_EXTRA_ORIGINS=
